{
  "manifest_version": 3,
  "name": "Dub Transcript Lab",
  "version": "0.9.5",
  "description": "Local video transcription, reusable transcripts, translation, and word-learning tools.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://de.wiktionary.org/*",
    "https://en.wiktionary.org/*",
    "https://translation.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-observer-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-observer-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dub Transcript Lab"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* https://de.wiktionary.org https://en.wiktionary.org https://translation.googleapis.com https://nflxvideo.net https://*.nflxvideo.net"
  }
}
